<?xml version="1.0" encoding="UTF-8"?>
<project name="aula-git-github" default="build" basedir=".">
    <property name="build.dir" value="build" />
    <property name="classes.dir" value="${build.dir}/classes" />

    <target name="clean">
        <delete dir="${build.dir}" />
    </target>

    <target name="build" depends="clean">
        <mkdir dir="${classes.dir}" />
        <javac srcdir="." destdir="${classes.dir}" includeantruntime="false"
               encoding="UTF-8" release="17">
            <include name="**/*.java" />
            <exclude name="build/**" />
        </javac>
    </target>

    <target name="run" depends="build">
        <java classname="OlaGithub" fork="true" dir="${classes.dir}">
            <classpath><pathelement location="${classes.dir}" /></classpath>
        </java>
    </target>
</project>
